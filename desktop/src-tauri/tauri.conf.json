{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blog Shorts",
  "version": "0.10.1",
  "identifier": "com.z3nma.blogshorts",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Blog Shorts", "width": 820, "height": 820, "minWidth": 520, "minHeight": 520, "decorations": false, "shadow": true }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://static2.typecast.ai; media-src 'self' https: http://asset.localhost asset:; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../*.mjs": "engine/",
      "../../voice_ai.py": "engine/voice_ai.py",
      "../../voice.ps1": "engine/voice.ps1",
      "../../layouts/*": "engine/layouts/",
      "../../fonts/*": "engine/fonts/"
    }
  }
}
